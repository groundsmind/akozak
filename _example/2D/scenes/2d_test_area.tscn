radius = 10.381587

[sub_resource type="GDScript" id="GDScript_0x0bl"]
script/source = "extends Sprite2D

@onready var scene_trans: ColorRect = $\"../SceneTransitionRect\"

func _on_interact_area_action_finish(action: InteractAction) -> void:
	match action.hint:
		\"To 3D Scene\":
			scene_trans.transition_to()
"

