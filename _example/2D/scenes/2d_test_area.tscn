[sub_resource type="GDScript" id="GDScript_faevs"]
script/source = "extends Sprite2D

func _on_interact_area_action_start(action: InteractAction) -> void:
	match action.hint.to_lower():
		\"spin\":
			var spin = create_tween()
			spin.tween_property(self, \"rotation\", rotation+1, 0.5).set_trans(Tween.TRANS_EXPO).set_ease(Tween.EASE_OUT)
"

[sub_resource type="Resource" id="Resource_2n03v"]
script = ExtResource("3_xepof")
hint = "Spin"
metadata/_custom_type_script = "uid://dodubb0x7t1y"

